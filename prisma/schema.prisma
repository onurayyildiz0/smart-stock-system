datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id          String            @id @default(cuid())
  sku         String            @unique
  name        String
  category    String
  price       Float             
  stocks      WarehouseStock[]
  demands     StoreDemand[]
  allocations AllocationItem[]
  createdAt   DateTime          @default(now())
}

model Warehouse {
  id          String            @id @default(cuid())
  name        String
  location    String
  capacity    Int               // Toplam depolama kapasitesi (Adet)
  stocks      WarehouseStock[]
  routes      WarehouseRoute[]
  allocations AllocationItem[]
  users       User[]
  createdAt   DateTime          @default(now())
}

model Store {
  id          String            @id @default(cuid())
  name        String
  location    String
  priority    Int               // 1: Standart, 2: Orta, 3: Yüksek
  demands     StoreDemand[]
  routes      WarehouseRoute[]
  users       User[]
  createdAt   DateTime          @default(now())
}

model WarehouseStock {
  id          String    @id @default(cuid())
  warehouseId String
  productId   String
  quantity    Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
}

model WarehouseRoute {
  id           String    @id @default(cuid())
  warehouseId  String
  storeId      String
  shippingCost Float     
  deliveryDays Int       
  priority     Int       @default(1)
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, storeId])
}

model StoreDemand {
  id                String            @id @default(cuid())
  storeId           String
  productId         String
  requestedQuantity Int
  // PENDING, PARTIAL, FULFILLED
  status            String            @default("PENDING") 
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  allocations       AllocationItem[]
  createdAt         DateTime          @default(now())
}

model AllocationRun {
  id              String           @id @default(cuid())
  totalCost       Float
  fulfillmentRate Float
  totalRequested  Int
  totalFulfilled  Int
  items           AllocationItem[]
  createdAt       DateTime         @default(now())
}

model AllocationItem {
  id           String        @id @default(cuid())
  runId        String
  demandId     String
  warehouseId  String
  productId    String
  allocatedQty Int
  unitCost     Float
  totalCost    Float
  deliveryDays Int
  run          AllocationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  demand       StoreDemand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
}




model User {
  id           String     @id @default(cuid())
  email        String     @unique
  password     String
  name         String
  role         String     @default("STORE_MANAGER") // "ADMIN" | "STORE_MANAGER" | "WAREHOUSE_MANAGER"
  isApproved   Boolean    @default(false)
  storeId      String?
  store        Store?     @relation(fields: [storeId], references: [id], onDelete: SetNull)

  warehouseId  String?
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  createdAt    DateTime   @default(now())
}